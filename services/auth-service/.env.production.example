# Copy to your secrets manager / server env — never commit real values.
# Replace YOURDOMAIN with your registrable domain (no protocol in COOKIE_DOMAIN).

NODE_ENV=production
PORT=4500
SERVICE_NAME=tatvaops-auth-service

# Comma-separated exact origins (scheme + host + port). Must include your live Next.js URL(s).
# Example: https://www.yourdomain.com,https://yourdomain.com
CORS_ORIGINS=https://www.YOURDOMAIN.com,https://YOURDOMAIN.com

# Where Google OAuth redirects after consent (must match Google Cloud Console).
# Example: https://auth.YOURDOMAIN.com/auth/google/callback
FRONTEND_URL=https://www.YOURDOMAIN.com
GOOGLE_CALLBACK_URL=https://auth.YOURDOMAIN.com/auth/google/callback

# Cookie policy for cross-site credentialed refresh (SPA on www, API on auth subdomain).
# Leading dot = parent domain and all subdomains (required for shared cookies across hosts).
COOKIE_DOMAIN=.YOURDOMAIN.com
COOKIE_SECURE=true

# Must match backend JWT_SECRET and be at least 32 chars
JWT_SECRET=use_the_same_value_as_backend_JWT_SECRET

DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

INTERNAL_EMAIL_DOMAINS=tatvaops.com
