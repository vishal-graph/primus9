# TatvaOps Vision — Worker
# Copy to .env and fill values (see backend/.env.example for many shared settings).

DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Optional: product catalog Postgres for moodboard + 3D view grounding.
# When using the backend BullMQ worker (`npm run queue:worker` from backend/), set this in
# backend/.env instead — backend copies it to process.env before worker handlers load.
# Encode @ in password as %40.
# PRODUCT_CATALOG_DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
# Strict verification: when true, sofa/tile generations must be catalog-grounded (DB-backed) or job fails.
# STRICT_CATALOG_SOFA_TILES=true

GEMINI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_FLOORPLANS=
S3_BUCKET_MOODBOARDS=
S3_BUCKET_RENDERS=
S3_BUCKET_EXPORTS=
