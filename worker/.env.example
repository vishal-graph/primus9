# TatvaOps Vision — Worker
# Copy to .env and fill values (see backend/.env.example for many shared settings).

DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Supabase Storage (replaces AWS S3)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
S3_BUCKET_FLOORPLANS=floorplans
S3_BUCKET_MOODBOARDS=moodboards
S3_BUCKET_RENDERS=renders
S3_BUCKET_EXPORTS=exports

# Optional: product catalog Postgres for moodboard + 3D view grounding.
# PRODUCT_CATALOG_DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
# STRICT_CATALOG_SOFA_TILES=true

GEMINI_API_KEY=
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
