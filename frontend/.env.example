# Public site URL (optional; used for absolute links in some flows)
# NEXT_PUBLIC_APP_URL=https://www.example.com

# Backend API (browser). Falls back to same-origin /api rewrites when unset.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# Server-side: direct backend base for `/api/health` aggregate probe (production).
# Example: https://api.example.com
# BACKEND_API_URL=

# Optional server-only auth base (else NEXT_PUBLIC_AUTH_SERVICE_URL is used for probes).
# AUTH_SERVICE_URL=

# Google Analytics 4 — optional; when unset, WebAnalytics is a no-op
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Legal URLs for Play Store / in-app links
# NEXT_PUBLIC_PRIVACY_POLICY_URL=https://www.example.com/privacy
# NEXT_PUBLIC_TERMS_URL=https://www.example.com/terms

# Maps (LocationPicker / onboarding)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Temporary integration mode: allow session-less UI when x_user_id is present
# (bypasses /login middleware; forwards x-user-id to backend)
# NEXT_PUBLIC_ALLOW_X_USER_ID_BYPASS=true
