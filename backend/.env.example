# =============================================================
# TatvaOps Vision — Backend .env
# Copy this file to backend/.env and fill in all required values
# =============================================================

# ── SERVER ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
SERVICE_NAME=tatvaops-vision-api
CORS_ORIGINS=https://app.primus9.ai,https://auth.primus9.ai,https://primus9.ai,https://www.primus9.ai

# ── DATABASE (Supabase PostgreSQL) ────────────────────────────
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Optional: product catalog Postgres (e.g. Supabase) for MOODBOARD + TWO_D_VIEWS grounding.
# Encode @ in password as %40. Omit to skip catalog (generative-only moodboards / views).
# PRODUCT_CATALOG_DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
# Strict verification: when true, sofa/tile generations must be catalog-grounded (DB-backed) or job fails.
# STRICT_CATALOG_SOFA_TILES=true

# ── REDIS ─────────────────────────────────────────────────────
# Local: redis://localhost:6379
# Upstash: use rediss://... from the dashboard, or redis://... (we auto-upgrade to TLS for *.upstash.io)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# BullMQ AI worker (`npm run queue:worker`). Default in code is 1 — safe for Supabase Session pooler.
# Raise only if you use Transaction pool (port 6543) or a larger DB pool.
# WORKER_CONCURRENCY=1

# Optional: cap Prisma pool inside worker handlers (appended to DATABASE_URL as connection_limit).
# WORKER_PRISMA_CONNECTION_LIMIT=1

# ── CUSTOM JWT AUTH (NEW — replaces Clerk) ────────────────────
# Must be at least 32 characters. Must MATCH services/auth-service/.env JWT_SECRET
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars

# Temporary integration mode: allow x-user-id header without JWT
ALLOW_X_USER_ID_BYPASS=false

# ── CLERK (DEPRECATED — keep if old users still exist, safe to remove later) ──
# CLERK_SECRET_KEY=sk_...
# CLERK_PUBLISHABLE_KEY=pk_...
# CLERK_WEBHOOK_SECRET=whsec_...

# ── SUPABASE STORAGE (replaces AWS S3) ───────────────────────
# Project URL — auto-derived from DATABASE_URL if omitted
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Bucket names — create matching buckets in Supabase → Storage (set public for moodboards/renders)
S3_BUCKET_FLOORPLANS=floorplans
S3_BUCKET_MOODBOARDS=moodboards
S3_BUCKET_RENDERS=renders
S3_BUCKET_EXPORTS=exports
S3_SIGNED_URL_EXPIRY=3600

# ── AWS (optional — only if using CloudWatch/SQS) ─────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1

# ── GOOGLE GEMINI AI ──────────────────────────────────────────
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
GEMINI_TEXT_API_VERSION=v1
GEMINI_IMAGE_API_VERSION=v1beta

# ── RESEND EMAIL ──────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM_ADDRESS=TatvaOps Vision <noreply@tatvaops.com>
EMAIL_REPLY_TO=support@tatvaops.com

# ── RAZORPAY PAYMENTS (optional) ──────────────────────────────
# RAZORPAY_KEY_ID=rzp_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...

# ── MSG91 WHATSAPP (optional) ─────────────────────────────────
# MSG91_AUTH_KEY=...
# MSG91_SENDER_ID=...
# MSG91_TEMPLATE_ID=...
MSG91_ENABLED=false

# ── RUNWAY VIDEO AI (optional) ────────────────────────────────
# RUNWAY_API_KEY=...

# ── CLOUDWATCH LOGS (optional) ────────────────────────────────
CLOUDWATCH_ENABLED=false
# CLOUDWATCH_LOG_GROUP=/tatvaops/vision
# CLOUDWATCH_LOG_STREAM=api

# ── RATE LIMITING ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=800
RATE_LIMIT_AI_WINDOW_MS=60000
RATE_LIMIT_AI_MAX_REQUESTS=10

# ── FEATURE FLAGS ─────────────────────────────────────────────
FEATURE_MOODBOARD_V2=false
FEATURE_3D_PREVIEW=false
FEATURE_COMPONENT_INJECTION=false
FEATURE_WHATSAPP_NOTIFICATIONS=false

# ── WORKER ────────────────────────────────────────────────────
WORKER_CONCURRENCY=3
