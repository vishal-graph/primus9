{
  "name": "tatvaops-vision-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "build:worker": "cd ../worker && npm run build",
    "queue:worker": "tsx src/workers/index.ts",
    "queue:worker:build": "npm run build:worker && npm run queue:worker"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.957.0",
    "@aws-sdk/client-s3": "^3.957.0",
    "@aws-sdk/client-ses": "^3.958.0",
    "@aws-sdk/client-sqs": "^3.957.0",
    "@aws-sdk/s3-request-presigner": "^3.957.0",
    "@clerk/backend": "^1.34.0",
    "@clerk/clerk-sdk-node": "^4.13.23",
    "@clerk/express": "^1.7.60",
    "@google/genai": "^1.40.0",
    "@google/generative-ai": "^0.2.1",
    "@prisma/client": "^5.8.0",
    "@types/pdfkit": "^0.17.4",
    "bullmq": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.8.2",
    "morgan": "^1.10.0",
    "pdfkit": "^0.17.2",
    "pino": "^8.17.2",
    "razorpay": "^2.9.6",
    "resend": "^6.9.3",
    "svix": "^1.82.0",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "pino-pretty": "^10.3.1",
    "prisma": "^5.8.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
